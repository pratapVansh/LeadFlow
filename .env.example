# Shared Docker and local configuration. Copy to root .env on first setup.
# Match existing database credentials; changing these does not update a stored password.
# Replace the password placeholder in .env before first startup; other values are usable defaults.
POSTGRES_USER=leadflow
POSTGRES_PASSWORD='replace_with_a_strong_password'
POSTGRES_DB=leadflow
POSTGRES_TEST_DB=leadflow_test
POSTGRES_PORT=5433
FRONTEND_PORT=3000
BACKEND_PORT=8000
# URLs are derived by each runtime; store each credential only once above.
# Quote passwords containing # or $ with single quotes; do not percent-encode them.
